{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/requirement-doc/**)",
      "Edit(/docs/sources/SRC-*/**)",
      "Edit(/docs/architecture/01-strategic-architecture-discovery.md)",
      "Edit(/ledger/approval-decisions/**)",
      "Edit(/.claude/state/**)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(gh pr review *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(Remove-Item * -Recurse *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.githooks/**)",
      "Edit(/tools/governance/**)",
      "Edit(/docs/governance/authority-matrix.yaml)",
      "Edit(/docs/governance/methodology.md)",
      "Edit(/docs/governance/conventions.md)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(winget *)",
      "Bash(choco *)",
      "PowerShell(pip install *)",
      "PowerShell(npm install *)",
      "PowerShell(winget *)",
      "PowerShell(choco *)"
    ],
    "allow": [
      "Bash(python tools/governance/check.py)",
      "Bash(python tools/governance/check.py *)",
      "Bash(python tools/governance/trace.py *)",
      "Bash(python tools/governance/approvals.py *)",
      "Bash(python tools/governance/run_tests.py)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/capture_approval.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
