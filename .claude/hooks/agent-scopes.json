{
  "_comment": "Write scopes and shell profiles per actor. Read by .claude/hooks/guard.py and by tools/governance/check.py (pre-commit and commit-msg). Changing this file is a framework change (authority matrix).",
  "protected": [
    "requirement-doc/**",
    "docs/sources/SRC-*/**",
    "docs/architecture/01-strategic-architecture-discovery.md",
    "ledger/approval-decisions/**",
    ".claude/state/**",
    ".git/**"
  ],
  "append_only": [
    "ledger/**"
  ],
  "orchestrator": {
    "write": ["**"],
    "shell": "orchestrator"
  },
  "agents": {
    "requirements-engineer": {
      "write": ["docs/requirements/**", "docs/changes/**"],
      "deny": ["docs/requirements/assurance/**"],
      "shell": "governance-readonly"
    },
    "requirements-assurance": {
      "write": ["docs/requirements/assurance/**", "ledger/reviews/**"],
      "shell": "governance-readonly"
    },
    "accounting-domain-expert": {
      "write": ["docs/accounting/**", "ledger/reviews/**"],
      "shell": "governance-readonly"
    },
    "code-security-reviewer": {
      "write": ["ledger/reviews/**"],
      "shell": "review-readonly"
    }
  },
  "unknown_agent": {
    "write": [],
    "shell": "governance-readonly"
  },
  "agent_shell_deny": [
    "\\s--output(=|\\s|$)",
    "\\s--ext-diff(\\s|$)",
    "\\s--textconv(\\s|$)",
    "\\s--pre(=|\\s|$)",
    "\\s-(exec|execdir|ok|okdir|delete|fprint0?|fprintf|fls)(\\s|$)"
  ],
  "shell_profiles": {
    "governance-readonly": {
      "allow": [
        "^python3? tools/governance/(check|trace)\\.py( .*)?$",
        "^git (status|log|show|diff|ls-files|rev-parse|blame)( .*)?$"
      ]
    },
    "review-readonly": {
      "allow": [
        "^python3? tools/governance/(check|trace|run_tests)\\.py( .*)?$",
        "^python3? -m unittest (discover -s tools/governance/tests -t \\.|tools\\.governance\\.tests(\\.\\w+)*)( -[vqf]| -k \\S+)*$",
        "^git (status|log|show|diff|ls-files|rev-parse|blame)( .*)?$",
        "^(rg|grep|ls|cat|head|tail|wc|find|sha256sum)( .*)?$"
      ]
    },
    "orchestrator": {
      "deny": [
        "(^|[\\s;&|(\"'])git(\\s+(-[Cc]\\s+(\"[^\"]*\"|'[^']*'|[^\\s\"'])+|--[\\w-]+(=\\S+)?|-[pP]))*\\s+push(\\s|$|\"|')",
        "(^|[\\s\"'])--force(\\s|$|-|=|\"|')",
        "(^|[\\s\"'])--no-verify(\\s|$|=|\"|')",
        "core\\.hookspath",
        "(^|[\\s;&|(\"'])git(\\s+(-[Cc]\\s+(\"[^\"]*\"|'[^']*'|[^\\s\"'])+|--[\\w-]+(=\\S+)?|-[pP]))*\\s+commit\\s(.*\\s)?-[a-zA-Z]*n(\\s|$)",
        "(^|[\\s;&|(\"'])git(\\s+(-[Cc]\\s+(\"[^\"]*\"|'[^']*'|[^\\s\"'])+|--[\\w-]+(=\\S+)?|-[pP]))*\\s+reset\\s(.*\\s)?--hard",
        "(^|[\\s;&|(\"'])git(\\s+(-[Cc]\\s+(\"[^\"]*\"|'[^']*'|[^\\s\"'])+|--[\\w-]+(=\\S+)?|-[pP]))*\\s+clean\\s(.*\\s)?-[a-zA-Z]*f",
        "(^|[\\s;&|(])rm\\s([^|;&\\n]*\\s)?-(?!-)[a-zA-Z]*[rR]",
        "(^|[\\s;&|(])(rm|rmdir|rd|ri|del|erase|Remove-Item)\\b[^|;\\n]*\\s(--recursive|-r(e(c[a-z]*)?)?\\b|/s\\b)",
        "(^|[\\s;&|(])gh\\s+pr\\s+(review|merge)",
        "(^|[\\s;&|(])gh\\s+api\\b.*(/reviews|/merge|mergePullRequest|addPullRequestReview|submitPullRequestReview)"
      ]
    }
  }
}
